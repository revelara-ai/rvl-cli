<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>csindex</AssemblyName>
    <RootNamespace>Csindex</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The fixture app under testdata/ is a scan TARGET, never part of the
       helper itself. Without this the SDK's default glob would compile the
       fixture (and its vendored stubs) into csindex. -->
  <ItemGroup>
    <Compile Remove="testdata/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>

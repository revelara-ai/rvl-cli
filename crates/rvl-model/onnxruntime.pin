# The ONNX Runtime every RELEASE archive vendors beside `rvl`.
#
# Release scan results must not depend on the scanning machine, so a release
# does not use whatever ONNX Runtime the machine has: it ships this one.
# ci/fetch-onnxruntime.sh reads this file in release CI and in the CI test
# jobs, verifies every download against the sha256 below and fails on any
# mismatch. tests/onnxruntime_pin.rs holds the `lib` triples to the `targets`
# in dist-workspace.toml, so a new release target cannot ship unpinned.
#
# LIBRARY: Microsoft's NuGet package Microsoft.ML.OnnxRuntime 1.31.0
# (api.nuget.org), which NuGet requires the publisher to sign. It replaced the
# CPU release archives on GitHub when github.com/microsoft/onnxruntime went
# away on 2026-11-17. One package holds the library for every target under
# runtimes/<rid>/native/, so every `lib` line names the same url and sha256
# and differs only in its library member. Each library is self-contained (on
# Linux it links only libc, libm, libdl, libpthread, librt, libstdc++ and
# libgcc_s). The checksum is the sha256 of the package, taken by download on
# 2026-11-18. Microsoft builds no osx-x64 runtime after 1.23.2, which is why
# x86_64-apple-darwin is not a release target.
#
# The package is a zip archive. Every member is a regular file, not a
# symlink, so the fetch copies it as is. The license member is ONNX
# Runtime's MIT license at the package root, and the ThirdPartyNotices.txt
# beside it ships too.
#
# To bump: change every line together (one ONNX Runtime version for all
# targets), take the sha256 of the package from a download of it, keep the
# `ort` crate in crates/rvl-model/Cargo.toml on the matching API version, and
# re-run `cargo test -p rvl-model`.
#
# Format, whitespace-separated, `#` starts a comment:
#   version <onnxruntime-version>
#   lib <rust-target-triple> <url> <sha256> <library-member> <license-member>

version 1.31.0

lib x86_64-unknown-linux-gnu https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/1.31.0/microsoft.ml.onnxruntime.1.31.0.nupkg 7e35fdb4f5adb62f01e60798e2e5ed05108f5fbbe1cca03fbcc37903cf7c5e3b runtimes/linux-x64/native/libonnxruntime.so LICENSE
lib aarch64-unknown-linux-gnu https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/1.31.0/microsoft.ml.onnxruntime.1.31.0.nupkg 7e35fdb4f5adb62f01e60798e2e5ed05108f5fbbe1cca03fbcc37903cf7c5e3b runtimes/linux-arm64/native/libonnxruntime.so LICENSE
lib aarch64-apple-darwin https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/1.31.0/microsoft.ml.onnxruntime.1.31.0.nupkg 7e35fdb4f5adb62f01e60798e2e5ed05108f5fbbe1cca03fbcc37903cf7c5e3b runtimes/osx-arm64/native/libonnxruntime.dylib LICENSE
